# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Better Auth (authentication) ---

# DATABASE_URL: Postgres connection string used by Better Auth to store
# users, sessions and accounts. Two options:
#  - Hosted (used in this project): Supabase → Project Settings → Database →
#    Connection string → "Transaction pooler" tab.
#  - Local dev: run `docker compose up -d` (see docker-compose.yml) for a
#    matching database at postgresql://prdgen:prdgen@localhost:5432/prdgen
# After setting this, run `npm run auth:migrate` once to create the tables.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# BETTER_AUTH_SECRET: random string used to sign sessions/tokens.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="MY_BETTER_AUTH_SECRET"

# BETTER_AUTH_URL: the base URL Better Auth issues cookies/callbacks for.
# Same value as APP_URL in most cases.
BETTER_AUTH_URL="http://localhost:3000"

# --- Pakasir (payment gateway) ---

# PAKASIR_SLUG / PAKASIR_API_KEY: from your project's page on
# https://app.pakasir.com (Project Details). Required for the "Pilih Paket"
# buttons on the Pricing page to work — without them, /api/checkout/pakasir
# returns a 503 instead of a checkout link.
# PAKASIR_SLUG=""
# PAKASIR_API_KEY=""

# PAKASIR_API_BASE: Pakasir API v2 host. Defaults to production if unset.
# PAKASIR_API_BASE="https://app.pakasir.com/api/v2"

# PAKASIR_WEBHOOK_SECRET: shown on (and resettable from) your project's
# settings page — NOT something we generate ourselves. Set the webhook URL
# in that same project settings page to:
#   <APP_URL>/api/webhooks/pakasir
# Pakasir sends this same secret back in every webhook's X-Secret header,
# which is what proves a request actually came from Pakasir.
# PAKASIR_WEBHOOK_SECRET=""

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: optional. Leave unset to run with
# email/password only — the Google button in the UI stays disabled until
# both are provided. Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client type "Web application"). Add ONE "Authorized redirect URI" per
# environment you run this in, e.g. both:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
# After editing env vars on a running server, the process must be fully
# restarted (not just reloaded) for dotenv to pick up the new values —
# verify with: curl <BETTER_AUTH_URL>/api/auth-status
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
